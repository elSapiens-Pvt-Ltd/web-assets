<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>elPOS Training Plan — Climate Naturals</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --wisteria-50:  hsl(218 31% 95%);
      --wisteria-100: hsl(218 31% 90%);
      --wisteria-200: hsl(218 32% 80%);
      --wisteria-300: hsl(218 34% 70%);
      --wisteria-400: hsl(218 34% 60%);
      --wisteria-500: hsl(218 33% 50%);
      --wisteria-600: hsl(218 33% 40%);
      --wisteria-700: hsl(218 33% 30%);
      --wisteria-800: hsl(218 33% 20%);
      --wisteria-850: hsl(218 33% 15%);
      --wisteria-900: hsl(218 33% 10%);
      --wisteria-950: hsl(220 33% 7%);
      --neutral-50:  hsl(0 0% 98%); --neutral-100: hsl(0 0% 96%);
      --neutral-200: hsl(0 0% 92%); --neutral-300: hsl(0 0% 85%);
      --neutral-400: hsl(0 0% 64%); --neutral-500: hsl(0 0% 45%);
      --neutral-600: hsl(0 0% 32%); --neutral-700: hsl(0 0% 25%);
      --neutral-900: hsl(0 0% 9%);
      --brand: var(--wisteria-400); --brand-dark: var(--wisteria-600);
      --brand-darker: var(--wisteria-800); --brand-light: var(--wisteria-300);
      --brand-xlight: var(--wisteria-50);
      --gray-50: var(--neutral-50); --gray-100: var(--neutral-100);
      --gray-200: var(--neutral-200); --gray-300: var(--neutral-300);
      --gray-400: var(--neutral-400); --gray-500: var(--neutral-500);
      --gray-600: var(--neutral-600); --gray-700: var(--neutral-700);
      --gray-900: var(--neutral-900);
      --red-light: hsl(0 70% 95%); --red: hsl(0 72% 45%);
      --amber-light: hsl(38 90% 92%); --amber: hsl(33 80% 38%);
      --teal: hsl(163 64% 30%); --teal-light: hsl(163 45% 92%);
      --green: hsl(142 60% 30%); --green-light: hsl(142 50% 94%);
      --purple: hsl(255 45% 50%); --purple-light: hsl(255 55% 96%);
      --shadow-sm: 0 1px 2px rgb(0 0 0 / .05);
      --shadow: 0 1px 3px rgb(0 0 0 / .08), 0 1px 2px -1px rgb(0 0 0 / .08);
      --shadow-md: 0 4px 12px -2px rgb(15 23 42 / .10);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Manrope', system-ui, sans-serif; background: var(--neutral-100); color: var(--gray-700); font-size: 14px; line-height: 1.6; -webkit-font-smoothing: antialiased; }

    /* COVER */
    .cover { background: linear-gradient(135deg, var(--wisteria-950) 0%, var(--wisteria-800) 100%); padding: 56px 48px 48px; }
    .cover-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--wisteria-300); margin-bottom: 18px; }
    .cover h1 { font-size: 42px; font-weight: 800; color: white; line-height: 1.1; margin-bottom: 8px; }
    .cover h1 span { color: var(--wisteria-300); font-style: italic; }
    .cover-sub { font-size: 15px; color: rgba(255,255,255,.6); margin-bottom: 28px; }
    .cover-meta { display: flex; gap: 32px; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,.1); padding-top: 20px; }
    .cover-meta div { display: flex; flex-direction: column; gap: 3px; }
    .lbl { font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--wisteria-400); }
    .cover-meta strong { color: white; font-size: 13px; font-weight: 600; }

    /* KEY DATES STRIP */
    .key-dates { display: flex; gap: 0; background: var(--wisteria-900); overflow: hidden; }
    .key-date { flex: 1; padding: 12px 16px; border-right: 1px solid rgba(255,255,255,.08); text-align: center; }
    .key-date:last-child { border-right: none; }
    .key-date .kd-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--wisteria-400); margin-bottom: 3px; }
    .key-date .kd-date { font-size: 15px; font-weight: 700; color: white; }
    .key-date .kd-note { font-size: 11px; color: rgba(255,255,255,.5); margin-top: 2px; }
    .key-date.highlight { background: var(--wisteria-700); }

    /* TAB NAV */
    .tab-nav { display: flex; align-items: center; gap: 4px; padding: 10px 24px; background: white; border-bottom: 1px solid var(--gray-200); position: sticky; top: 0; z-index: 100; box-shadow: var(--shadow); flex-wrap: wrap; }
    .tab-nav-label { font-size: 11px; font-weight: 700; color: var(--gray-400); letter-spacing: .06em; text-transform: uppercase; margin-right: 6px; }
    .tab-btn { font-family: 'Manrope', sans-serif; font-size: 12px; font-weight: 600; padding: 6px 14px; border-radius: 6px; border: 1px solid transparent; cursor: pointer; background: transparent; color: var(--gray-500); transition: all .15s; }
    .tab-btn:hover { background: var(--gray-100); color: var(--gray-700); }
    .tab-btn.active { background: var(--wisteria-800); color: white; }

    /* TAB VISIBILITY */
    body[data-view="plan"]    [data-tab]:not([data-tab~="plan"])    { display: none !important; }
    body[data-view="mod1"]    [data-tab]:not([data-tab~="mod1"])    { display: none !important; }
    body[data-view="mod2"]    [data-tab]:not([data-tab~="mod2"])    { display: none !important; }
    body[data-view="mod3"]    [data-tab]:not([data-tab~="mod3"])    { display: none !important; }
    body[data-view="mod4"]    [data-tab]:not([data-tab~="mod4"])    { display: none !important; }
    body[data-view="eval"]    [data-tab]:not([data-tab~="eval"])    { display: none !important; }

    /* CONTAINER */
    .container { max-width: 976px; margin: 0 auto; padding: 32px 24px 64px; }

    /* HUB HEADER */
    .hub-header { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--gray-200); }
    .hub-icon { width: 40px; height: 40px; border-radius: 10px; background: var(--wisteria-800); color: white; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
    .hub-header h2 { font-size: 22px; font-weight: 700; color: var(--gray-900); }
    .hub-header p  { font-size: 13px; color: var(--gray-500); margin-top: 3px; }

    /* PAGE CARD */
    .page-card { background: white; border-radius: 12px; border: 1px solid var(--gray-200); overflow: hidden; margin-bottom: 16px; box-shadow: var(--shadow-sm); }
    .page-card-header { display: flex; align-items: flex-start; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--gray-200); }
    .page-name { font-size: 15px; font-weight: 700; color: var(--gray-900); }
    .page-sub  { font-size: 12px; color: var(--gray-500); margin-top: 3px; }

    /* BADGES */
    .badge { font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; border: 1px solid; white-space: nowrap; }
    .b-plan   { background: var(--wisteria-50); color: var(--wisteria-800); border-color: var(--wisteria-200); }
    .b-mod1   { background: hsl(200 60% 95%); color: hsl(200 60% 25%); border-color: hsl(200 50% 80%); }
    .b-mod2   { background: var(--green-light); color: var(--green); border-color: hsl(142 40% 80%); }
    .b-mod3   { background: hsl(38 90% 94%); color: hsl(33 80% 30%); border-color: hsl(38 70% 78%); }
    .b-mod4   { background: var(--purple-light); color: var(--purple); border-color: hsl(255 40% 80%); }
    .b-eval   { background: var(--red-light); color: var(--red); border-color: hsl(0 60% 82%); }
    .b-admin  { background: hsl(163 45% 94%); color: var(--teal); border-color: hsl(163 40% 78%); }
    .b-done   { background: var(--green-light); color: var(--green); border-color: hsl(142 40% 80%); }
    .b-live   { background: #fef2f2; color: #991b1b; border-color: #fecaca; }

    /* CARD GRID */
    .card-grid { display: grid; grid-template-columns: 1fr 1fr; }
    .col { padding: 20px 22px; border-right: 1px solid var(--gray-200); }
    .col:last-child { border-right: none; }
    .col-full { grid-column: 1 / -1; padding: 20px 22px; border-top: 1px solid var(--gray-200); }
    .col-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; }
    .col-3 .col { border-right: 1px solid var(--gray-200); }
    .col-3 .col:last-child { border-right: none; }
    @media (max-width: 680px) { .card-grid,.col-3 { grid-template-columns: 1fr; } .col { border-right: none; border-bottom: 1px solid var(--gray-200); } }

    /* SECTION LABEL */
    .section-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--wisteria-600); margin-bottom: 10px; }

    /* FEATURES */
    ul.features { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 7px; }
    ul.features li { font-size: 13px; color: var(--gray-700); padding-left: 14px; position: relative; line-height: 1.55; }
    ul.features li::before { content: '–'; position: absolute; left: 0; color: var(--wisteria-400); font-weight: 600; }

    /* USER STORY CARDS */
    .stories { padding: 20px 22px; display: flex; flex-direction: column; gap: 10px; }
    .story { padding: 13px 16px; background: var(--gray-50); border-radius: 8px; border: 1px solid var(--gray-200); }
    .story-id { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--wisteria-600); margin-bottom: 5px; }
    .story-text { font-size: 13px; color: var(--gray-700); line-height: 1.6; }
    .story-text strong { color: var(--gray-900); }
    .story-note { margin-top: 8px; padding: 7px 10px; background: #fef9c3; border-left: 3px solid #eab308; border-radius: 0 5px 5px 0; font-size: 12px; color: #713f12; }
    .story-demo { margin-top: 8px; padding: 7px 10px; background: var(--wisteria-50); border-left: 3px solid var(--wisteria-400); border-radius: 0 5px 5px 0; font-size: 12px; color: var(--wisteria-800); }
    .story-mgr  { margin-top: 8px; padding: 7px 10px; background: var(--teal-light); border-left: 3px solid var(--teal); border-radius: 0 5px 5px 0; font-size: 12px; color: var(--teal); }

    /* KEYBOARD KEY */
    kbd { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 600; padding: 1px 6px; background: white; border: 1px solid var(--gray-300); border-bottom: 2px solid var(--gray-400); border-radius: 4px; color: var(--gray-700); line-height: 1.5; }

    /* NOTICE */
    .notice-warn { margin-bottom: 14px; padding: 14px 18px; background: #fef2f2; border-left: 4px solid #dc2626; border-radius: 0 8px 8px 0; font-size: 13px; color: #374151; }
    .notice-warn .notice-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #dc2626; margin-bottom: 6px; }
    .notice-info { margin-bottom: 20px; padding: 12px 18px; background: var(--brand-xlight); border-left: 3px solid var(--brand-dark); border-radius: 0 8px 8px 0; font-size: 13px; color: var(--brand-darker); }
    .notice-success { padding: 12px 18px; background: var(--green-light); border-left: 3px solid var(--green); border-radius: 0 8px 8px 0; font-size: 13px; color: var(--green); margin-bottom: 14px; }

    /* SECTION DIVIDER */
    .section-divider { margin: 28px 0 16px; display: flex; align-items: center; gap: 12px; background: #1a1a2e; border-radius: 8px; padding: 10px 16px; }
    .sd-title { font-size: 13px; font-weight: 700; color: #fff; letter-spacing: .04em; }
    .sd-sub   { font-size: 12px; color: rgba(255,255,255,.6); }

    /* TIMELINE */
    .timeline { display: flex; flex-direction: column; gap: 0; position: relative; padding-left: 32px; }
    .timeline::before { content: ''; position: absolute; left: 11px; top: 8px; bottom: 8px; width: 2px; background: var(--gray-200); }
    .tl-item { display: flex; gap: 14px; position: relative; padding-bottom: 24px; }
    .tl-item:last-child { padding-bottom: 0; }
    .tl-dot { width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; color: white; position: absolute; left: -32px; top: 1px; }
    .tl-dot.sa  { background: #1e3a5f; }
    .tl-dot.dh  { background: var(--teal); }
    .tl-dot.ev  { background: var(--amber); }
    .tl-dot.ml  { background: var(--red); }
    .tl-dot.go  { background: var(--green); }
    .tl-body { flex: 1; }
    .tl-date { font-size: 11px; font-weight: 700; color: var(--gray-400); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 3px; }
    .tl-title { font-size: 14px; font-weight: 700; color: var(--gray-900); margin-bottom: 3px; }
    .tl-desc  { font-size: 13px; color: var(--gray-600); }
    .tl-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .tl-chip  { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 12px; border: 1px solid; }
    .chip-sa { background: #e8eef7; color: #1e3a5f; border-color: #b8c8df; }
    .chip-dh { background: var(--teal-light); color: var(--teal); border-color: hsl(163 40% 75%); }
    .chip-all { background: var(--wisteria-50); color: var(--wisteria-700); border-color: var(--wisteria-200); }

    /* ROLE LEGEND */
    .role-legend { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; font-size: 12px; font-weight: 600; }
    .role-dot { display: flex; align-items: center; gap: 6px; }
    .role-dot span { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }

    /* EVAL GRID */
    .eval-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 20px 22px; }
    .eval-item { padding: 14px 16px; border-radius: 8px; border: 1px solid var(--gray-200); background: var(--gray-50); }
    .eval-item .ei-title { font-size: 13px; font-weight: 700; color: var(--gray-900); margin-bottom: 6px; }
    .eval-item .ei-pts  { font-size: 11px; font-weight: 700; color: var(--wisteria-600); margin-bottom: 8px; text-transform: uppercase; letter-spacing: .05em; }
    .eval-item ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 5px; }
    .eval-item li { font-size: 12px; color: var(--gray-700); padding-left: 12px; position: relative; }
    .eval-item li::before { content: '✓'; position: absolute; left: 0; color: var(--green); font-size: 10px; font-weight: 700; top: 1px; }

    /* FLOW STEPS */
    .flow-steps { display: flex; flex-direction: column; }
    .flow-step { display: flex; gap: 14px; position: relative; }
    .flow-step:not(:last-child)::before { content: ''; position: absolute; left: 15px; top: 32px; width: 2px; height: calc(100% - 10px); background: var(--gray-200); }
    .step-num { width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0; background: var(--wisteria-800); color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; margin-top: 2px; }
    .step-body { flex: 1; padding: 4px 0 20px; }
    .step-body strong { font-size: 13px; color: var(--gray-900); display: block; margin-bottom: 2px; }
    .step-body p { font-size: 13px; color: var(--gray-600); }

    /* SCREENSHOT PLACEHOLDER */
    .screenshot-slot { margin-top: 14px; border: 2px dashed var(--gray-300); border-radius: 8px; padding: 20px; text-align: center; background: var(--gray-50); }
    .screenshot-slot img { max-width: 100%; border-radius: 6px; border: 1px solid var(--gray-200); box-shadow: 0 2px 8px rgba(0,0,0,.08); display: block; }
    .screenshot-slot .ph { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--gray-400); }

    /* MODULE OVERVIEW CHIPS */
    .module-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
    .mod-chip { display: flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; border: 1px solid; }
  </style>
</head>
